{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(corepack:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(du:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(curl -sI:*)",
      "Read(//J/Code/Anime_Organize/anime-vault/**)",
      "Edit(//J/Code/Anime_Organize/anime-vault/**)",
      "Write(//J/Code/Anime_Organize/anime-vault/**)",
      "Glob(//J/Code/Anime_Organize/anime-vault/**)",
      "Grep(//J/Code/Anime_Organize/anime-vault/**)",
      "WebFetch(domain:graphql.anilist.co)",
      "WebFetch(domain:anilist.co)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:authjs.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:sharp.pixelplumbing.com)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:zod.dev)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm run db:push:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./CLAUDE.local.md)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Edit(./drizzle/meta/**)",
      "Edit(./package-lock.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run enrich:*)",
      "Bash(npx vercel:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}

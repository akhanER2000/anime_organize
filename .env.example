# ANIME VAULT · plantilla de variables de entorno
#
# Copia este fichero a .env.local y rellénalo:
#     cp .env.example .env.local
#
# .env.local NUNCA se commitea (.gitignore usa denegación total sobre .env*
# con una única excepción para este fichero).
#
# NINGUNA variable de aquí lleva un valor real. Si añades una nueva, documenta
# DE DÓNDE se saca, no solo cómo se llama.


# ════════════════════════════════════════════════════════════════════════════
# BASE DE DATOS · Neon  (OBLIGATORIAS)
# ════════════════════════════════════════════════════════════════════════════
#
# console.neon.tech → tu proyecto → Connection Details.
# Copia LAS DOS cadenas, de la rama en la que vayas a trabajar (`development`).
#
#   pooled    → lleva "-pooler" en el host. Es la que usa la APLICACIÓN.
#   unpooled  → la misma sin "-pooler". Es la que usan MIGRACIONES y SCRIPTS,
#               porque el DDL largo no va por el pooler.
#
# LA CADENA DE PRODUCCIÓN NO VIVE EN TU DISCO. Ni aquí, ni "un momento para
# probar algo": va solo en las variables de Vercel del entorno Production.
# Ver .claude/rules/security.md §7.
#
# Recuerda: las extensiones de Postgres (citext, pg_trgm, unaccent) son POR RAMA
# de Neon. Una rama nueva nace sin ellas y la migración 0001 falla.

DATABASE_URL=
DATABASE_URL_UNPOOLED=


# ════════════════════════════════════════════════════════════════════════════
# AUTENTICACIÓN · Auth.js v5  (OBLIGATORIAS)
# ════════════════════════════════════════════════════════════════════════════
#
# AUTH_SECRET firma los JWT de sesión. Genera uno con:
#     npx auth secret
# Usa uno DISTINTO en desarrollo, en preview y en producción: compartirlo
# significa que un token de preview vale en producción.

AUTH_SECRET=

# La URL pública real del despliegue. En local se puede dejar vacía.
# En Vercel: https://tu-proyecto.vercel.app  (o tu dominio propio)
AUTH_URL=

# ¿Hay que verificar el email antes de poder entrar?
#
# Por defecto FALSE. Mientras el vault sea de una sola persona, verificar tu
# propio correo no aporta nada y bloquearía el arranque. Los caminos de código y
# sus tests existen igualmente: activarlo es cambiar esta variable, no reescribir
# la autenticación.
#
# Solo la cadena exacta "true" activa. "1", "yes" o "si" NO activan: ante la
# duda, no se bloquea el acceso.
#
# Ponla a true el día que abras el registro a terceros — y verifica antes un
# dominio en Resend, o los correos no saldrán.
AUTH_REQUIRE_EMAIL_VERIFICATION=false


# ════════════════════════════════════════════════════════════════════════════
# CORREO · Resend  (OPCIONAL — sin esto la app funciona igual)
# ════════════════════════════════════════════════════════════════════════════
#
# SIN RESEND_API_KEY  → driver de consola: el enlace de verificación o de
#                       recuperación se imprime en el log del servidor, completo
#                       y clicable. Es el modo normal de desarrollo.
# CON RESEND_API_KEY  → se envía de verdad.
#
# Clave: resend.com/api-keys
#
# Plan gratuito: 3.000 correos/mes, 100/día, 1 dominio verificado.
# OJO: hasta verificar un dominio propio, Resend solo deja enviar a TU PROPIA
# dirección. Abre el registro a terceros después de verificarlo.
#
# EMAIL_FROM tiene que ser una dirección de ese dominio verificado.
# Si pones la clave y olvidas el remitente, la app avisa y cae a consola en vez
# de romper el registro.

RESEND_API_KEY=
EMAIL_FROM=


# ════════════════════════════════════════════════════════════════════════════
# IA · Anthropic  (OPCIONAL — FASE 4)
# ════════════════════════════════════════════════════════════════════════════
#
# console.anthropic.com → API Keys.
#
# Sin esta clave, el paso 2 del enriquecimiento SE SALTA CON UN AVISO y el
# paso 1 (AniList, público y gratuito) sigue funcionando. Eso es comportamiento
# correcto, no un fallo.

ANTHROPIC_API_KEY=

# Modelo del paso 2. Por defecto claude-sonnet-5 (gama Sonnet, elegida en el
# encargo). No lo cambies sin motivo: es una decisión del propietario.
ANTHROPIC_MODEL=claude-sonnet-5


# ════════════════════════════════════════════════════════════════════════════
# LOGIN CON GOOGLE  (OPCIONAL — no implementado todavía)
# ════════════════════════════════════════════════════════════════════════════
#
# El esquema ya está preparado (tabla accounts con UNIQUE (provider,
# provider_account_id)) y la política de vinculación está decidida y testeada,
# pero el proveedor NO está cableado: necesita proyecto en Google Cloud,
# pantalla de consentimiento y una URL de callback desplegada.
#
# Cuando toque: console.cloud.google.com → APIs y servicios → Credenciales →
# ID de cliente de OAuth → Aplicación web.
# Callback: https://TU-DOMINIO/api/auth/callback/google
#
# RECORDATORIO DE SEGURIDAD: allowDangerousEmailAccountLinking se queda en false.
# La vinculación solo desde Ajustes, con sesión iniciada, nunca por coincidencia
# de email. Ver .claude/rules/security.md §2 bis.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ════════════════════════════════════════════════════════════════════════════
# ESPEJO DE PORTADAS EN GOOGLE DRIVE  (OPCIONAL — FASE 2)
# ════════════════════════════════════════════════════════════════════════════
#
# Si se configura, cada portada se sube TAMBIÉN a Drive y se guarda su id.
# Si Drive falla, la aplicación sigue funcionando: LA BASE DE DATOS ES LA FUENTE
# DE VERDAD, Drive es solo un espejo.
#
# Cuenta de servicio: console.cloud.google.com → IAM → Cuentas de servicio →
# Crear clave (JSON). Comparte la carpeta destino con el email de esa cuenta.

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=


# ════════════════════════════════════════════════════════════════════════════
# SEED  (solo para `npm run seed`)
# ════════════════════════════════════════════════════════════════════════════
#
# El usuario propietario de los 83 animes de animes-seed.json. Si no existe, el
# script lo crea con SEED_OWNER_PASSWORD. No reutilices una contraseña real.

SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

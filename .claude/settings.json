{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(corepack:*)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git grep:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(du:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",

      "Read(./**)",
      "Edit(./**)",

      "WebFetch(domain:graphql.anilist.co)",
      "WebFetch(domain:anilist.co)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:authjs.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:sharp.pixelplumbing.com)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:zod.dev)"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npx vercel --prod:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(iwr:*)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",

      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.development.local)",
      "Edit(./.env.test)",
      "Edit(./.env.test.local)",
      "Edit(./.env.staging)",
      "Edit(./.env.production)",
      "Edit(./.env.production.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.production)",

      "Read(./CLAUDE.local.md)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Edit(./drizzle/meta/**)",
      "Edit(./package-lock.json)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh:*)",
      "Bash(npm run db:push:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run enrich:*)",
      "Bash(npx vercel:*)"
    ],

    "defaultMode": "acceptEdits"
  },

  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
